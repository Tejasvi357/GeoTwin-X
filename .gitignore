# Geospatial Rasters & Binary Grids
*.tif
*.tiff
*.geotif
*.geotiff
*.dem
*.img
*.jp2
*.h5
*.hdf5
*.nc
*.vrt

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Keys
.env
.venv/
venv/
*.log

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
